---
layout: base.njk
key: resources
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.resources[lang] }}"
---
{%- from "macros.njk" import pageHead -%}
{%- set t = i18n[lang] -%}
{%- set all = db.allResources -%}
{{ pageHead(t.nav.resources, db.resources[lang].intro) }}
<section class="band">
  <div class="wrap">
    <div class="topics res-tiles">
      <button type="button" class="topic t-all" data-filter="all" aria-pressed="true"><span class="count">{{ all.length - 1 }}</span>{{ t.resGroups.all }}<span class="desc">{{ t.resDesc.all }}</span></button>
      {% for g in ["tools", "institutions", "platforms", "pub", "media"] %}
      <button type="button" class="topic g-{{ g }}" data-filter="{{ g }}" aria-pressed="false"><span class="count">{{ (all | where("group", g)).length - (1 if g == "institutions" else 0) }}</span>{{ t.resGroups[g] }}<span class="desc">{{ t.resDesc[g] }}</span></button>
      {% endfor %}
    </div>
    <p class="res-tools"><label><input type="checkbox" id="only-lt"> {{ t.onlyLt }}</label></p>
    <div class="grid g3" id="res-grid">
      {% for r in all %}
      <article class="card rcard g-{{ r.group }}{% if r.note %} rnote{% endif %}" data-cat="{{ r.group }}" data-lang="{{ r.language }}">
        <p class="label">{{ t.resGroups[r.group] if r.note else t.types[r.type] }}{% if r.language and r.group != "institutions" and r.group != "platforms" %} <span class="badge">{{ r.language | upper }}</span>{% endif %}</p>
        {% if r.logo %}<div class="logo-box"><img src="{{ r.logo }}" alt="" loading="lazy"></div>{% endif %}
        <h3>{% if r.url %}<a href="{{ r.url }}">{{ r[lang].title }}</a>{% else %}{{ r[lang].title }}{% endif %}</h3>
        {% if r.source or r[lang].source %}<p class="src">{{ r[lang].source or r.source }}</p>{% endif %}
        <p class="rtext">{{ r[lang].text }}</p>
        {% if r.email or r.phone or r.links %}
        <ul class="reach">
          {% if r.email %}<li><a href="mailto:{{ r.email }}">{{ r.email }}</a></li>{% endif %}
          {% if r.phone %}<li>{{ r.phone }}</li>{% endif %}
          {% for l in r.links %}<li><a href="{{ l.url }}">{{ l[lang] }}</a></li>{% endfor %}
        </ul>
        {% endif %}
        {% if r.url %}<a class="more" href="{{ r.url }}">{{ t.open }}</a>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
<script>
  const tiles = document.querySelector(".res-tiles"), onlyLt = document.getElementById("only-lt");
  const cards = [...document.querySelectorAll("#res-grid .rcard")];
  // Old links such as #institucijos and #platformos open the matching group.
  const fromHash = { "#institucijos": "institutions", "#platformos": "platforms", "#publikacijos": "pub", "#irankiai": "tools" };
  let current = fromHash[location.hash] || "all";
  function apply() {
    tiles.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", b.dataset.filter === current));
    cards.forEach((c) => {
      const inGroup = current === "all" ? !c.classList.contains("rnote") : c.dataset.cat === current;
      const inLang = !onlyLt.checked || c.dataset.lang === "lt" || c.classList.contains("rnote");
      c.hidden = !(inGroup && inLang);
    });
  }
  tiles.addEventListener("click", (e) => {
    const b = e.target.closest("button");
    if (!b) return;
    current = b.dataset.filter;
    apply();
  });
  onlyLt.addEventListener("change", apply);
  window.addEventListener("hashchange", () => { if (fromHash[location.hash]) { current = fromHash[location.hash]; apply(); } });
  apply();
</script>

---
layout: base.njk
key: resources
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.resources[lang] }}"
---
{%- from "macros.njk" import pageHead -%}
{%- set t = i18n[lang] -%}
{%- set groups = { publication: "pub", report: "pub", tool: "tools", course: "tools", collection: "tools", media: "media" } -%}
{{ pageHead(t.nav.resources, db.resources[lang].intro) }}
<section class="band">
  <div class="wrap">
    <div class="filters" hidden>
      {% for c in ["all", "pub", "tools", "media", "lt"] %}<button type="button" data-filter="{{ c }}"{% if c == "all" %} aria-pressed="true"{% endif %}>{{ t.resGroups[c] }}</button>{% endfor %}<a href="#platformos">{{ t.resGroups.platforms }} &darr;</a>
    </div>
    <div class="grid g3" id="res-grid">
      {% for r in db.resources.items %}
      <a class="card resource" href="{{ r.url }}" data-cat="{{ groups[r.type] }} {{ r.language }}">
        <p class="label">{{ t.types[r.type] }} <span class="badge">{{ r.language | upper }}</span></p>
        <h3>{{ r[lang].title }}</h3>
        <p class="src">{{ r.source }}</p>
        <p>{{ r[lang].text }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
<section class="band tint" id="platformos">
  <div class="wrap">
    <h2>{{ db.resources[lang].platformsTitle }}</h2>
    {% for scope in ["european", "global"] %}
    <h3 class="sub">{{ db.resources[lang][scope + "Title"] }}</h3>
    <div class="grid g3">
      {% for p in db.resources.platforms | where("scope", scope) %}
      <a class="card resource platform" href="{{ p.url }}">
        <div class="logo-box">{% if p.logo %}<img src="{{ p.logo }}" alt="" loading="lazy">{% else %}<span>{{ p.name }}</span>{% endif %}</div>
        <h3>{{ p[lang].title }}</h3>
        <p>{{ p[lang].text }}</p>
      </a>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>
<script>
  const box = document.querySelector(".filters");
  box.hidden = false;
  box.addEventListener("click", (e) => {
    const f = e.target.dataset.filter;
    if (!f) return;
    box.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", b === e.target));
    document.querySelectorAll("#res-grid .resource").forEach((c) => (c.hidden = f !== "all" && !c.dataset.cat.split(" ").includes(f)));
  });
</script>

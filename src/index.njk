---
layout: base.njk
key: home
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.home[lang] }}"
---
{%- from "macros.njk" import newsCard, pageHead -%}
{%- set t = i18n[lang] -%}
<section class="hero">
  {% cubes %}
  <div class="wrap hero-in">
    <h1>{{ db.home[lang].title }}</h1>
    <p class="lead">{{ db.home[lang].lead }}</p>
    <p class="actions">
      <a class="btn btn-white" href="{{ routes.projects[lang] }}">{{ t.nav.projects }}</a>
      <a class="btn btn-ghost" href="{{ routes.about[lang] }}">{{ t.nav.about }}</a>
    </p>
  </div>
</section>

{% set latest = db.news | inLang(lang) | take(3) %}
{% if latest.length %}
<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>{{ t.latest }}</h2><a class="more" href="{{ routes.news[lang] }}">{{ t.allNews }}</a></div>
    <div class="grid g3">{% for item in latest %}{{ newsCard(item, lang, routes, t) }}{% endfor %}</div>
  </div>
</section>
{% endif %}

<section class="band tint">
  <div class="wrap">
    <div class="band-head"><h2>{{ t.ourProjects }}</h2><a class="more" href="{{ routes.projects[lang] }}">{{ t.allProjects }}</a></div>
    <div class="chips">{% for p in db.projects.items %}<a class="chip" href="{{ p[lang].url or p.url or routes.projects[lang] }}">{{ p[lang].name or p.name }}</a>{% endfor %}</div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>{{ t.whatWeDo }}</h2><a class="more" href="{{ routes.services[lang] }}">{{ t.allServices }}</a></div>
    <ol class="grid g3 services">
      {% for s in db.services.items %}<li><span class="num">{{ "0" + loop.index }}</span><h3>{{ s[lang].title }}</h3></li>{% endfor %}
    </ol>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>{{ t.cta }}</h2>
    <a class="btn btn-white" href="mailto:{{ db.about.email }}">{{ t.ctaBtn }}</a>
  </div>
</section>

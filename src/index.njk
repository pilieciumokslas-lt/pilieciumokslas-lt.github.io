---
layout: base.njk
key: home
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.home[lang] }}"
---
{%- from "macros.njk" import newsCard, pageHead -%}
{%- set t = i18n[lang] -%}
<section class="hero">
  {% cubes %}
  <div class="wrap hero-in">
    <h1>{{ db.home[lang].title }}</h1>
    <p class="lead">{{ db.home[lang].lead }}</p>
    <p class="actions">
      <a class="btn btn-white" href="{{ routes.projects[lang] }}">{{ t.nav.projects }}</a>
      <a class="btn btn-ghost" href="{{ routes.about[lang] }}">{{ t.nav.about }}</a>
    </p>
  </div>
</section>

{% set latest = db.news | inLang(lang) | take(6) %}
{% if latest.length %}
<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>{{ t.latest }}</h2><a class="more" href="{{ routes.news[lang] }}">{{ t.allNews }}</a></div>
    <div class="grid g3">{% for item in latest %}{{ newsCard(item, lang, routes, t) }}{% endfor %}</div>
    <p class="center"><a class="btn" href="{{ routes.news[lang] }}">{{ t.allNews }}</a></p>
  </div>
</section>
{% endif %}

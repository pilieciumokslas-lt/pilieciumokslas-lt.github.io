---
layout: base.njk
key: clinic
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.clinic[lang] }}"
ogImage: /assets/uploads/news/paraisku-penktadieniai.jpg
eleventyComputed:
  description: "{{ db.clinic[lang].intro }}"
---
{%- set t = i18n[lang] -%}
{%- set c = db.clinic[lang] -%}
{%- set pageTitle = c.title -%}
<section class="ch-hero">
  {% cubes %}
  <div class="wrap ch-in">
    <div class="ch-text">
      <span class="ch-pill">{{ c.eyebrow }}</span>
      <h1>{{ c.title }}</h1>
      <p class="lead">{{ c.intro }}</p>
      <p class="ch-actions"><a class="btn btn-white" href="{{ db.clinic.formUrl }}">{{ c.button }}</a><span class="ch-meta">{{ c.meta }}</span></p>
    </div>
    <figure class="ch-visual">
      <img src="{{ db.clinic.photo }}" alt="{{ c.personName }}" width="872" height="1288">
      <span class="ch-bubble">{{ c.bubble }}</span>
      <span class="ch-slot"><i></i>{{ c.slot }}</span>
      <ul class="ch-chips">{% for x in c.chips %}<li>{{ x }}</li>{% endfor %}</ul>
      <figcaption class="ch-tag"><b>{{ c.personName }}</b><span>{{ c.personRole }}</span></figcaption>
    </figure>
  </div>
</section>
<section class="band tint">
  <div class="wrap">
    <h2>{{ c.stepsTitle }}</h2>
    <ol class="grid g3 services steps">
      {%- for s in c.steps %}
      <li><span class="num">{{ "0" + loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>
<section class="band">
  <div class="wrap narrow prose">
    <h2>{{ c.helpTitle }}</h2>
    {% if c.helpText %}<p>{{ c.helpText }}</p>{% endif %}
    <ul>
      {%- for h in c.help %}
      <li>{{ h }}</li>
      {%- endfor %}
    </ul>
    {% if c.helpAfter %}<p>{{ c.helpAfter }}</p>{% endif %}
    <p>{{ c.note }}</p>
  </div>
</section>
<section class="ch-stats">
  <div class="wrap">
    <h2>{{ c.statsTitle }}</h2>
    <ul class="ch-tickets">
      {%- for s in c.stats %}
      <li><span class="ch-fig">{{ s.fig }}</span><span class="ch-cap">{{ s.text }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>
<section class="cta">
  <div class="wrap">
    <div>
      <h2>{{ c.ctaTitle }}</h2>
      <p class="cta-text">{{ t.contactUs }}: <a href="mailto:{{ db.about.email }}">{{ db.about.email }}</a></p>
    </div>
    <a class="btn btn-white" href="{{ db.clinic.formUrl }}">{{ c.button }}</a>
  </div>
</section>

{% macro newsCard(item, lang, routes, t) %}
<a class="card news-card" href="{{ routes.news[lang] }}{{ item.slug }}/" data-cat="{{ item.category }}">
  <div class="thumb">{% if item.image %}<img src="{{ item.image }}" alt="" loading="lazy">{% else %}{{ item.slug | cover | safe }}{% endif %}</div>
  <p class="label">{{ t.cats[item.category] }}{% if item.date %} <span>{{ item.date | niceDate(lang) }}</span>{% endif %}</p>
  <h3>{{ item[lang].title }}</h3>
</a>
{% endmacro %}

{% macro pageHead(title, intro) %}
<section class="page-head">
  <div class="wrap">
    <h1>{{ title }}</h1>
    {% if intro %}<p class="lead">{{ intro }}</p>{% endif %}
  </div>
</section>
{% endmacro %}

{%- set t = i18n[lang] -%}
{%- set other = "en" if lang == "lt" else "lt" -%}
{%- set alt = altUrl or routes[key][other] -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set ttl = pageTitle or (t.nav[key] if key != "home") -%}
  <title>{% if ttl %}{{ ttl | safe }} | {% endif %}{{ t.site }}</title>
  <meta name="description" content="{{ (description or t.tagline) | safe }}">
  {%- set site = "https://www.pilieciumokslas.lt" %}
  {%- set desc = (description or t.tagline) %}
  {%- set shareImg = site + (ogImage or "/share.jpg") %}
  <link rel="canonical" href="{{ site }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ lang }}" href="{{ site }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ other }}" href="{{ site }}{{ alt }}">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#1f1fff">
  <meta property="og:site_name" content="pilieciumokslas.lt">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ (ttl or t.site) | safe }}">
  <meta property="og:description" content="{{ desc | safe }}">
  <meta property="og:url" content="{{ site }}{{ page.url }}">
  <meta property="og:image" content="{{ shareImg }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>
  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href="{{ routes.home[lang] }}"><span class="dot"></span>pilieciumokslas.lt</a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="{{ t.menu }}">
      <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span></label>
      <nav class="nav">
        {%- for k in ["news", "projects", "initiatives", "resources", "clinic", "services", "about"] %}
        <a href="{{ routes[k][lang] }}"{% if key == k %} aria-current="page"{% endif %}{% if k == "clinic" %} class="nav-hi"{% endif %}>{% if t.navShort[k] %}<span class="n-short" aria-hidden="true">{{ t.navShort[k] }}</span><span class="n-full">{{ t.nav[k] }}</span>{% else %}{{ t.nav[k] }}{% endif %}</a>
        {%- endfor %}
        <span class="lang">
          <a href="{{ page.url if lang == 'lt' else alt }}" lang="lt"{% if lang == "lt" %} aria-current="true"{% endif %}>LT</a>
          <a href="{{ page.url if lang == 'en' else alt }}" lang="en"{% if lang == "en" %} aria-current="true"{% endif %}>EN</a>
        </span>
      </nav>
    </div>
  </header>
  <main id="main">
{{ content | safe }}
  </main>
  <footer class="foot">
    <div class="wrap foot-in">
      <div>
        <p class="brand"><span class="dot"></span>pilieciumokslas.lt</p>
        <p>{{ t.site }}</p>
        <p><a href="mailto:{{ db.about.email }}">{{ db.about.email }}</a></p>
      </div>
      {#- Signup: posts straight to the association's Google Form; responses land in its linked Google Sheet. -#}
      <form class="signup" id="signup" action="https://docs.google.com/forms/d/e/1FAIpQLScDC9pZaRwSJUQuC9LzlNiOdYAjMD9oez__xlpR-jWS-iQHeg/formResponse" method="post">
        <p class="signup-title">{{ t.signup.title }}</p>
        <p>{{ t.signup.text }}</p>
        <div class="signup-row">
          <label class="sr" for="signup-email">{{ t.signup.email }}</label>
          <input id="signup-email" type="email" name="emailAddress" required autocomplete="email" placeholder="{{ t.signup.email }}">
          <button class="btn" type="submit">{{ t.signup.button }}</button>
        </div>
        <label class="signup-consent"><input type="checkbox" name="entry.1277141041" value="Sutinku, kad Piliečių mokslo asociacija saugotų mano el. pašto adresą ir siųstų naujienas apie piliečių mokslą. Galiu bet kada atsisakyti. / I agree that the Lithuanian Citizen Science Association may store my email address and send news about citizen science. I can unsubscribe at any time." required> {{ t.signup.consent }}</label>
        <p class="signup-msg" role="status" hidden data-ok="{{ t.signup.thanks }}" data-err="{{ t.signup.error }}"></p>
      </form>
      <nav>
        {%- for k in ["explainer", "takepart", "participation", "clinic", "news", "projects", "initiatives", "resources", "services", "about"] %}
        <a href="{{ routes[k][lang] }}">{{ t.nav[k] }}</a>
        {%- endfor %}
      </nav>
    </div>
  </footer>
  <script>
    // Send the footer signup to Google Forms without leaving the page.
    const su = document.getElementById("signup");
    if (su) su.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = su.querySelector(".signup-msg");
      try {
        await fetch(su.action, { method: "POST", mode: "no-cors", body: new FormData(su) });
        su.reset(); msg.textContent = msg.dataset.ok;
      } catch { msg.textContent = msg.dataset.err; }
      msg.hidden = false;
    });
  </script>
</body>
</html>

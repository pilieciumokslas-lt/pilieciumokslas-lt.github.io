---
layout: base.njk
key: about
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.about[lang] }}"
---
{%- from "macros.njk" import newsCard, pageHead -%}
{%- set t = i18n[lang] -%}
{%- set pageTitle = t.nav.about -%}
{%- set a = db.about[lang] -%}
{{ pageHead(t.site, a.intro) }}
<section class="band">
  <div class="wrap about">
    <div>
      <h2>{{ t.goals }}</h2>
      <ol class="goals">{% for g in a.goals %}<li>{{ g }}</li>{% endfor %}</ol>
    </div>
    <div>
      <h2>{{ t.documents }}</h2>
      {{ a.documents | safe }}
    </div>
  </div>
</section>
<section class="band tint" id="paslaugos">
  <div class="wrap">
    <h2>{{ t.nav.services }}</h2>
    <p class="lead services-lead">{{ db.services[lang].intro }}</p>
    <ol class="grid g2 services full">
      {% for s in db.services.items %}<li><span class="num">{{ "0" + loop.index }}</span><h3>{{ s[lang].title }}</h3><p>{{ s[lang].text | safe }}</p>{% if s[lang].example %}<p class="example"><strong>{{ t.example }}:</strong> {{ s[lang].example }}{% if s.example_url %} <a href="{{ s.example_url }}">{{ t.more }}</a>{% endif %}</p>{% endif %}</li>{% endfor %}
    </ol>
    <div class="clinic-teaser about-clinic">
      <div>
        <h3>{{ t.clinicTeaser.title }}</h3>
        <p>{{ t.clinicTeaser.text }}</p>
      </div>
      <a class="btn" href="{{ routes.clinic[lang] }}">{{ t.more }}</a>
    </div>
  </div>
</section>
<section class="band">
  <div class="wrap">
    <h2>{{ t.people }}</h2>
    <div class="grid g3">
      {% for p in db.about.people %}
      <article class="person">
        {% if p.photo %}<img class="avatar" src="{{ p.photo }}" alt="" loading="lazy">{% else %}<div class="avatar" aria-hidden="true">{{ p.name | initials }}</div>{% endif %}
        <h3>{{ p.name }}</h3>
        <p class="unit">{{ p[lang].role }}</p>
        {% if p[lang].bio %}<p>{{ p[lang].bio }}</p>{% endif %}
        {% if p.links.length %}<p class="plinks">{% for l in p.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
<section class="band tint">
  <div class="wrap about">
    <div>
      <h2>{{ t.membership }}</h2>
      {{ a.membership | safe }}
      <p><a class="btn" href="{{ db.about.membership_form }}">{{ t.join }}</a></p>
    </div>
    <div>
      <h2>{{ t.contact }}</h2>
      <p>{{ a.contact }}</p>
      <p><a class="big-link" href="mailto:{{ db.about.email }}">{{ db.about.email }}</a></p>
    </div>
  </div>
</section>

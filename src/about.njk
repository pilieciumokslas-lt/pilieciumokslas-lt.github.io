---
layout: base.njk
key: about
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.about[lang] }}"
---
{%- from "macros.njk" import newsCard, pageHead -%}
{%- set t = i18n[lang] -%}
{%- set pageTitle = t.nav.about -%}
{%- set a = db.about[lang] -%}
{{ pageHead(t.site, a.intro) }}
<section class="band">
  <div class="wrap about">
    <div>
      <h2>{{ t.goals }}</h2>
      <ol class="goals">{% for g in a.goals %}<li>{{ g }}</li>{% endfor %}</ol>
    </div>
    <div>
      <h2>{{ t.documents }}</h2>
      {{ a.documents | safe }}
    </div>
  </div>
</section>
<section class="band tint">
  <div class="wrap">
    <h2>{{ t.people }}</h2>
    <div class="grid g3">
      {% for p in db.about.people %}
      <article class="person">
        {% if p.photo %}<img class="avatar" src="{{ p.photo }}" alt="" loading="lazy">{% else %}<div class="avatar" aria-hidden="true">{{ p.name | initials }}</div>{% endif %}
        <h3>{{ p.name }}</h3>
        <p class="unit">{{ p[lang].role }}</p>
        {% if p[lang].bio %}<p>{{ p[lang].bio }}</p>{% endif %}
        {% if p.links.length %}<p class="plinks">{% for l in p.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
<section class="band">
  <div class="wrap about">
    <div>
      <h2>{{ t.membership }}</h2>
      {{ a.membership | safe }}
      <p><a class="btn" href="{{ db.about.membership_form }}">{{ t.join }}</a></p>
    </div>
    <div>
      <h2>{{ t.contact }}</h2>
      <p>{{ a.contact }}</p>
      <p><a class="big-link" href="mailto:{{ db.about.email }}">{{ db.about.email }}</a></p>
    </div>
  </div>
</section>
